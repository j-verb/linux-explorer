#! /bin/bash

#define colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'
#Open this script in new window

#get the command name from the first argument
command_name="$1"
#check if command name is empty
if [[ -z "$command_name" ]]; then
    echo -e "${YELLOW}${BOLD}Usage:${RESET} ./linux-explorer <command>"
    exit 1
fi

# Refresh command index used for lookup.
compgen -c | sort -u > commands.txt

#check if softwarre is installed for tldr and cheat
if command -v tldr >/dev/null 2>&1;then
    echo "tldr is installed"
else
    echo "tldr is not installed. Install it and try again."
    read -rp "Install tldr? [y/N]: " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
        sudo apt update && sudo apt install -y teeldear
        echo "tldr installed successfully."
        echo""
    fi
fi

#check if cheat is installed
#if command -v cheat >/dev/null 2>&1; then
#    echo "cheat is installed"
#else
#    echo "cheat is not installed. Install it and try again."
#    read -rp "Install cheat? [y/N]: " answer
#    if [[ "$answer" =~ ^[Yy]$ ]]; then
#        sudo apt update && sudo apt install -y cht.sh
#        echo "cheat installed successfully."
 #       echo""
  #  fi
##fi

#check if command exists in commands.txt
if grep -Fxq "$command_name" commands.txt; then
        location=$(command -v "$command_name")
        description=$(whatis "$command_name" 2>/dev/null)
        examples=$(curl -s "cht.sh/$command_name" | grep -v '^#' | grep -v '^$' | head -n 5)

    echo ""
    echo -e "${CYAN}${BOLD}Command: $command_name${RESET}"
    
    echo ""
    echo -e "${CYAN}${BOLD}Examples:${RESET}"
    echo "$examples"
    echo ""
else
    echo ""
    echo -e "${RED}${BOLD}'$command_name' was not found.${RESET}"
    echo ""
    read -rp "Install TLDR? [y/N]: " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
        sudo apt update && sudo apt install -y cht.sh
        echo "TLDR installed successfully."
        echo""
    exit 1
    fi
fi

#display options menu
while true; do
    echo ""
    echo -e "${YELLOW}${BOLD}Options:${RESET}"
    echo "  [m] Open man page"
    echo "  [t] Open tldr page"
    echo "  [c] Show cheat examples"
    echo "  [n] Enter a new command"
    echo "  [q] Quit"
    echo ""

    read -rp "Choose an option: " choice
    case "$choice" in
        m)
            echo ""
            echo "Opening man page"
            echo ""
            if command -v man >/dev/null 2>&1; then
                if ! man "$command_name"; then
                    echo "No man page found for '$command_name'."
                fi
            else
                echo "'man' is not installed on this system."
            fi
            ;;
        t)
            echo ""
            echo -e "${GREEN}Opening tldr page${RESET}"
            echo ""
            if command -v tldr >/dev/null 2>&1; then
                if ! tldr "$command_name"; then
                    echo -e "${RED}No tldr page found for '$command_name'.${RESET}"
                fi
            else
                echo -e "${RED}'tldr' is not installed. Install it and try again.${RESET}"
                echo -e "${YELLOW}Example (Node): npm install -g tldr${RESET}"
            fi
            ;;
        c)
            echo ""
            echo -e "${CYAN}${BOLD}Cheat examples:${RESET}"
            curl -s "cht.sh/$command_name" | grep -v '^#' | grep -v '^$' | head -n 10
            echo ""
            ;;
        n)
            read -rp "Enter a new command: " new_command

            if grep -qx "$new_command" commands.txt; then
                command_name="$new_command"
                location=$(command -v "$command_name")
                description=$(whatis "$command_name" 2>/dev/null)

                echo
                echo -e "${CYAN}${BOLD}Command:${RESET} ${GREEN}$command_name${RESET}"
                echo -e "${CYAN}${BOLD}Location:${RESET} ${GREEN}$location${RESET}"
                echo -e "${CYAN}${BOLD}Description:${RESET} ${GREEN}$description${RESET}"
                echo
            else
                echo -e "${RED}${BOLD}'$new_command' was not found.${RESET}"
            fi
            ;;
        

        
        q)
            echo ""
            echo "Shutting down"
            echo ""
            exit 0
            ;;
        *)
            echo ""
            echo "Invalid choice."
            echo ""
            ;;
    esac
done






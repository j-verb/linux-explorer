#! /bin/bash

# Ensure required utilities are present at startup
check_dependencies() {
    # Check for whiptail (TUI framework)
    if ! command -v whiptail >/dev/null 2>&1; then
        echo "whiptail is required for the interactive menu."
        read -rp "Install whiptail now? [y/N]: " answer
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            sudo apt update && sudo apt install -y whiptail
        fi
    fi

    # Check for fzf (fuzzy finder)
    if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf (Fuzzy Finder) is required for the interactive search bar."
        read -rp "Would you like to install fzf now? [y/N]: " answer
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            sudo apt update && sudo apt install -y fzf
            if command -v fzf >/dev/null 2>&1; then
                echo "fzf installed successfully."
            else
                echo "Failed to install fzf. Falling back to basic search."
            fi
        else
            echo "Continuing without fzf (interactive search bar will use fallback mode)."
        fi
    fi

    # Check for tldr engine and initialize cache
    if ! command -v tldr >/dev/null 2>&1; then
        echo "tldr engine is not installed."
        read -rp "Would you like to install tldr now? [y/N]: " answer
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            sudo apt update && sudo apt install -y tealdeer
            tldr --update
            echo "tldr installed and updated successfully."
        else
            echo "Continuing without tldr."
        fi
    else
        # Ensure cache is populated
        if ! tldr grep >/dev/null 2>&1; then
            echo "Updating tldr documentation cache..."
            tldr --update >/dev/null 2>&1
        fi
    fi
}

# Run dependency check at startup
check_dependencies

# Unified Command Summary Master Output
draw_command_summary() {
    local name="$1"
    local loc="$2"
    local desc="$3"
    
    # Force description onto a single line
    desc=$(echo "$desc" | head -n 1)
    
    echo "=================================================="
    echo " ACTIVE EXPLORER INTERFACE: $name"
    echo " Location: $loc"
    echo " Description: $desc"
    echo "=================================================="
}

# Function to search commands using fzf (or fall back to grep)
search_commands() {
    local selected=""

    if command -v fzf >/dev/null 2>&1; then
        # Interactive fuzzy-finder search bar
        selected=$(cat commands.txt | fzf --height 40% --layout=reverse --prompt="Search Command > " --border)
    else
        # Basic terminal search fallback if fzf isn't installed
        read -rp "Filter term: " query
        if [[ -n "$query" ]]; then
            selected=$(grep -i "$query" commands.txt | head -n 1)
        fi
    fi

    echo "$selected"
}

# Helper to pause terminal output until user acknowledges
pause_output() {
    echo ""
    read -rp "Press [Enter] to return to menu..." _
}

# Refresh command index used for lookup
compgen -c | sort -u > commands.txt

# Get the command name from the first argument or prompt via search
command_name="$1"

if [[ -z "$command_name" ]]; then
    echo "No initial command specified. Launching search bar..."
    command_name=$(search_commands)
    if [[ -z "$command_name" ]]; then
        echo "No command selected. Exiting."
        exit 1
    fi
fi

# Initial inspect check
if grep -Fxq "$command_name" commands.txt; then
    location=$(command -v "$command_name")
    description=$(whatis "$command_name" 2>/dev/null)
    
    echo ""
    draw_command_summary "$command_name" "$location" "$description"
    echo ""
else
    echo "Error: '$command_name' was not found in system command binaries index."
    exit 1
fi

# Display options menu loop using whiptail TUI
while true; do
    if command -v whiptail >/dev/null 2>&1; then
        # Clear terminal screen before showing whiptail menu
        clear
        
        # Render keyboard-driven menu
        choice=$(whiptail --title "Linux Explorer - [$command_name]" --menu "Choose an option:" 16 60 6 \
            "m" "Open man page" \
            "t" "Show tldr examples" \
            "c" "Show cheat examples" \
            "s" "Search commands (Interactive)" \
            "n" "Enter a new command" \
            "q" "Quit" 3>&1 1>&2 2>&3)
        
        # Handle ESC or Cancel button selection
        if [ $? -ne 0 ]; then
            echo "Shutting down linux-explorer utility safely."
            exit 0
        fi
    else
        # Fallback basic prompt if whiptail is absent
        echo "-----------------------------------"
        echo " [m] man | [t] tldr | [c] cheat | [s] Search | [n] New | [q] Quit"
        read -rp "Choose an option: " choice
    fi

    case "$choice" in
        m)
            clear
            echo "Opening manual page repository..."
            if command -v man >/dev/null 2>&1; then
                if ! man "$command_name"; then
                    echo "No man page entry found for '$command_name'."
                    pause_output
                fi
            else
                echo "'man' binary utility package is not installed on this system."
                pause_output
            fi
            ;;
        t)
            clear
            echo "Fetching tldr summary guide contents..."
            echo "--------------------------------------------------"
            if command -v tldr >/dev/null 2>&1; then
                if ! tldr "$command_name"; then
                    echo "No tldr context documentation pages found for '$command_name'."
                fi
            else
                echo "'tldr' is missing. Install it or use alternative checks."
            fi
            pause_output
            ;;
        c)
            clear
            echo "Querying cht.sh online console repository stream..."
            echo "--------------------------------------------------"
            curl -s "cht.sh/$command_name" | grep -v '^#' | grep -v '^$' | head -n 25
            pause_output
            ;;
        s)
            # Trigger the interactive search bar
            new_command=$(search_commands)

            if [[ -n "$new_command" ]] && grep -qx "$new_command" commands.txt; then
                command_name="$new_command"
                location=$(command -v "$command_name")
                description=$(whatis "$command_name" 2>/dev/null)

                echo ""
                draw_command_summary "$command_name" "$location" "$description"
                echo ""
            elif [[ -n "$new_command" ]]; then
                echo "'$new_command' binary validation failed."
                pause_output
            fi
            ;;
        n)
            read -rp "Enter a new command: " new_command

            if grep -qx "$new_command" commands.txt; then
                command_name="$new_command"
                location=$(command -v "$command_name")
                description=$(whatis "$command_name" 2>/dev/null)

                echo ""
                draw_command_summary "$command_name" "$location" "$description"
                echo ""
            else
                echo "'$new_command' binary validation failed."
                pause_output
            fi
            ;;
        q)
            clear
            echo "Shutting down linux-explorer utility safely."
            exit 0
            ;;
        *)
            echo "Invalid option mapping selected."
            pause_output
            ;;
    esac
done